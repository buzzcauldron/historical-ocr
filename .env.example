# LLM keys (at least one for manuscript transcription)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# historical-ocr defaults
HISTORICAL_OCR_JOBS_DIR=jobs
HISTORICAL_OCR_DEFAULT_PROVIDER=anthropic
# HISTORICAL_OCR_MODEL=claude-sonnet-4-20250514
HISTORICAL_OCR_LINEATION_BACKEND=glyph_machina
HISTORICAL_OCR_PDF_DPI=300
HISTORICAL_OCR_JPEG_QUALITY=90
HISTORICAL_OCR_MAX_IMAGE_WIDTH=3000
# HISTORICAL_OCR_MAX_IMAGE_HEIGHT=
HISTORICAL_OCR_MAX_IMAGE_PIXELS=16000000
HISTORICAL_OCR_FINGERPRINT_DPI=800
HISTORICAL_OCR_FINGERPRINT_SEG_DPI=300
HISTORICAL_OCR_TESSERACT_LANG=lat+frk+eng
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata
# HISTORICAL_OCR_BIB_PREPROCESS=1
# HISTORICAL_OCR_PDF_DENSITY_OCR=0
# HISTORICAL_OCR_FAST_MODE=0
# HISTORICAL_OCR_PARALLEL_PAGES=1

# Ted Underwood print cleanup (ocr-cleanup sibling)
HISTORICAL_OCR_CLEAN_PRINT=1
# HISTORICAL_OCR_CLEAN_VARIANTS=1   # modernise spelling (off by default)
# HISTORICAL_OCR_CLEAN_LLM=gemini     # optional LLM stage (gemini uses GOOGLE_API_KEY)
# HISTORICAL_OCR_CLEAN_LLM=anthropic  # needs ANTHROPIC_API_KEY + credits
# HISTORICAL_OCR_CLEAN_LLM_MODEL=gemini-2.5-flash

# Diachronic print OCR (document type + fork)
HISTORICAL_OCR_PRINT_DOC_TYPE=auto
HISTORICAL_OCR_PRINT_LANGUAGE=auto
# HISTORICAL_OCR_PUBLICATION_YEAR=1688
HISTORICAL_OCR_OCR_COMBINATION=tesseract_then_clean
HISTORICAL_OCR_NORMALIZATION_MODE=normalized

# Page material CNN (--mode auto routing)
# HISTORICAL_OCR_PAGE_CNN_MODEL=models/page_cnn.pt
# HISTORICAL_OCR_PAGE_CNN_THRESHOLD=0.5

# transcription-shell / kraken (optional)
# TRANSCRIBER_SHELL_KRAKEN_MODEL_PATH=/path/to/blla.mlmodel
# MANUSCRIPT_FINGERPRINT_KRAKEN_MODEL_PATH=/path/to/blla.mlmodel
